# ===== RailVoice production environment =====
# Copy to repo root as `.env.production` and fill every required value.
# NEVER commit the real `.env.production`.

# --- Domains (used by compose build + CORS) ---
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
PUBLIC_BASE_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
CORS_ORIGINS=https://app.example.com,https://www.app.example.com

HTTP_PORT=80
HTTPS_PORT=443

# --- Postgres ---
POSTGRES_USER=railvoice
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=railvoice

# --- App secrets ---
SECRET_KEY=CHANGE_ME_LONG_RANDOM_64_CHARS_MINIMUM
APP_ENV=production
DEBUG=false

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Auth providers ---
OTP_MOCK_MODE=false
OTP_MOCK_CODE=
GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_MOCK_MODE=false

# --- AI (optional; falls back to local embeddings) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DUPLICATE_SIMILARITY_THRESHOLD=0.82

# --- Storage ---
STORAGE_BACKEND=local
# For S3/MinIO later:
# STORAGE_BACKEND=s3
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=railvoice-uploads
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=ap-south-1

# --- Bootstrap ---
# Set true ONLY on first deploy to seed stations/roles/super-admin
RUN_SEED=true

# Rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_OTP_PER_MINUTE=5
RATE_LIMIT_WRITE_PER_MINUTE=30
