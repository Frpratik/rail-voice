# Local Next.js → local API (no proxy needed)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Auth UI
# Set NEXT_PUBLIC_GOOGLE_CLIENT_ID to enable real Google Identity Services
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# When CLIENT_ID is empty, mock Google button is shown unless:
NEXT_PUBLIC_GOOGLE_MOCK=true
# Hide seed OTP hints on admin when false:
NEXT_PUBLIC_OTP_MOCK=true

# Production (Vercel): leave unset OR set to same-origin proxy path:
# NEXT_PUBLIC_API_URL=/api/v1
# API_PROXY_TARGET=https://rail-voice.onrender.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_MOCK=false
# NEXT_PUBLIC_OTP_MOCK=false
