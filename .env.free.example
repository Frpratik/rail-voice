# ===== Free-tier demo env (staging) =====
# APP_ENV must NOT be "production" so mock OTP / Google stay allowed.

APP_ENV=staging
DEBUG=false
SECRET_KEY=replace-with-random-32chars-minimum-secret

# Neon connection strings (Dashboard → Connection details)
# Use the pooled string for the app; enable SSL.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/neondb?ssl=require
DATABASE_URL_SYNC=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional — leave empty when CELERY_ENABLED=false
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_ENABLED=false

# After Render gives you a URL like https://railvoice-api.onrender.com
PUBLIC_BASE_URL=https://YOUR-API.onrender.com
CORS_ORIGINS=https://YOUR-APP.vercel.app,http://localhost:3000

OTP_MOCK_MODE=true
OTP_MOCK_CODE=123456
GOOGLE_OAUTH_MOCK_MODE=true
RUN_SEED=true

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage/uploads
RATE_LIMIT_ENABLED=true
