APP_NAME=RailVoice
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+asyncpg://railvoice:railvoice@localhost:5432/railvoice
DATABASE_URL_SYNC=postgresql://railvoice:railvoice@localhost:5432/railvoice
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DUPLICATE_SIMILARITY_THRESHOLD=0.82

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OTP_MOCK_MODE=true
OTP_MOCK_CODE=123456

GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_MOCK_MODE=true

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage/uploads
PUBLIC_BASE_URL=http://localhost:8000
S3_ENDPOINT=
S3_BUCKET=railvoice-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1

RATE_LIMIT_ENABLED=true
