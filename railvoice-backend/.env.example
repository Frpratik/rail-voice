APP_NAME=RailVoice
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+asyncpg://railvoice:railvoice@localhost:5432/railvoice
DATABASE_URL_SYNC=postgresql://railvoice:railvoice@localhost:5432/railvoice
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DUPLICATE_SIMILARITY_THRESHOLD=0.82

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OTP_MOCK_MODE=true
OTP_MOCK_CODE=123456
OTP_TTL_SECONDS=300
OTP_LENGTH=6
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=RAILVC

GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_MOCK_MODE=true
GOOGLE_AUTH_ENABLED=true

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage/uploads
PUBLIC_BASE_URL=http://localhost:8000
S3_ENDPOINT=
S3_BUCKET=railvoice-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1
S3_PUBLIC_BASE_URL=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=auto
RATE_LIMIT_OTP_PER_MINUTE=5
RATE_LIMIT_WRITE_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_OTP_PER_MOBILE_PER_HOUR=5
RATE_LIMIT_REQUIRE_REDIS_IN_PRODUCTION=true

SLA_HOURS_SEVERITY_1=4
SLA_HOURS_SEVERITY_2=12
SLA_HOURS_SEVERITY_3=24
SLA_HOURS_SEVERITY_4=48
SLA_HOURS_SEVERITY_5=72
